{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "firebase": {
      "command": "npx",
      "env": {
        "npm_config_cache": "${PLUGIN_DATA}/npm-cache",
        "XDG_CONFIG_HOME": "${PLUGIN_DATA}/config",
        "npm_config_ignore_scripts": "true",
        "XDG_CACHE_HOME": "${PLUGIN_DATA}/cache",
        "HOME": "${PLUGIN_DATA}",
        "USERPROFILE": "${PLUGIN_DATA}"
      },
      "args": [
        "-y",
        "firebase-tools@15.33.0",
        "mcp"
      ],
      "type": "stdio"
    },
    "setup": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/status.mjs"
      ]
    }
  }
}
